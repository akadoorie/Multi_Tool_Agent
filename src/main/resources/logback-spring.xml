<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dev logging (layer 2). Distinct from the JSONL task store (layer 1), which is the persistent,
  queryable observability artifact. Every line includes the task_id from the MDC so all log output
  for one request is correlated.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [task:%X{task_id:-none}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
