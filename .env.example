# Copy this file to .env and fill in your key:  cp .env.example .env
# Get a key from https://console.anthropic.com/  (Settings -> API Keys).
# The real .env is gitignored and never committed.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — app log verbosity: TRACE | DEBUG | INFO (default) | WARN | ERROR.
# DEBUG surfaces per-call token/cache usage from the agent loop. Uncomment to change:
#LOGGING_LEVEL_COM_TUFIN_AGENT=DEBUG
